  <diagram id="page_1" name="1.系统初始化流程">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1300" math="0" shadow="0">
      <root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="n_start" value="系统上电 / 复位" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="30" width="200" height="45" as="geometry" /></mxCell>
<mxCell id="n_serial" value="初始化串口 (115200)&#xa;delay(200)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="105" width="200" height="45" as="geometry" /></mxCell>
<mxCell id="n_psram" value="检查/初始化 PSRAM&#xa;(psramInit)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="180" width="220" height="60" as="geometry" /></mxCell>
<mxCell id="n_err" value="输出错误并停止&#xa;(PSRAM does not work)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="187" width="180" height="45" as="geometry" /></mxCell>
<mxCell id="n_epdpwr" value="配置屏幕电源引脚&#xa;GPIO 46 (OUTPUT, 0)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="270" width="220" height="45" as="geometry" /></mxCell>
<mxCell id="n_epdinit" value="epd_init(&amp;DEMO_BOARD, &amp;ED060KD1, EPD_LUT_64K)&#xa;初始化板卡与屏幕参数" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="345" width="260" height="50" as="geometry" /></mxCell>
<mxCell id="n_vcom" value="epd_set_vcom(1560)&#xa;设置 VCOM 电压 1560mV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="425" width="220" height="45" as="geometry" /></mxCell>
<mxCell id="n_rot" value="epd_set_rotation(EPD_ROT_INVERTED_PORTRAIT)&#xa;设置竖屏倒置 (1072x1448)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="500" width="260" height="45" as="geometry" /></mxCell>
<mxCell id="n_layout" value="layout_compute()&#xa;计算状态栏/卡片/应用网格坐标" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="575" width="240" height="45" as="geometry" /></mxCell>
<mxCell id="n_btn" value="btn_adc_init()&#xa;配置 GPIO 19 为 12位 ADC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="650" width="220" height="45" as="geometry" /></mxCell>
<mxCell id="n_clear" value="使能供电 -&gt; epd_clear() 清屏 -&gt; 断电" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="725" width="240" height="45" as="geometry" /></mxCell>
<mxCell id="n_alloc" value="在 PSRAM 中申请静态显存 g_static_fb&#xa;(heap_caps_malloc SPIRAM)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="800" width="260" height="50" as="geometry" /></mxCell>
<mxCell id="n_drawstatic" value="draw_static()&#xa;渲染底图、状态栏、卡片、8应用、Tab" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="880" width="260" height="50" as="geometry" /></mxCell>
<mxCell id="n_prepare" value="prepare_home()&#xa;memcpy 底图到前台 fb 并叠加初始焦点高亮框" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="960" width="280" height="50" as="geometry" /></mxCell>
<mxCell id="n_fullrefresh" value="full_refresh()&#xa;全屏刷新 (MODE_GC16 灰度清除残影)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1040" width="240" height="50" as="geometry" /></mxCell>
<mxCell id="n_loop" value="进入主循环 idf_loop()&#xa;开始周期性按键轮询" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="1120" width="220" height="45" as="geometry" /></mxCell>
