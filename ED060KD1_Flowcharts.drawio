  <diagram id="page_2" name="2.ADC按键检测与消抖">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1100" math="0" shadow="0">
      <root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="p2_start" value="主循环定时 20ms 触发&#xa;btn_poll_event()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="30" width="220" height="45" as="geometry" /></mxCell>
<mxCell id="p2_read" value="读取 GPIO 19 原始 ADC 计数值&#xa;btn_read_raw() [0..4095]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="105" width="220" height="45" as="geometry" /></mxCell>
<mxCell id="p2_hyst" value="当前处于已按下状态且在迟滞区间内?&#xa;(min_raw - 40 &lt;= raw &lt;= max_raw + 40)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="180" width="300" height="70" as="geometry" /></mxCell>
<mxCell id="p2_keep" value="保持当前按键不变&#xa;return s_btn_state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="192" width="170" height="45" as="geometry" /></mxCell>
<mxCell id="p2_w1" value="2150 &lt;= raw &lt;= 2950 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="280" width="200" height="60" as="geometry" /></mxCell>
<mxCell id="p2_k1" value="判定为 KEY1 (UP)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="287" width="160" height="45" as="geometry" /></mxCell>
<mxCell id="p2_w2" value="1400 &lt;= raw &lt;= 2050 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="370" width="200" height="60" as="geometry" /></mxCell>
<mxCell id="p2_k2" value="判定为 KEY2 (OK)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="377" width="160" height="45" as="geometry" /></mxCell>
<mxCell id="p2_w3" value="650 &lt;= raw &lt;= 1250 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="460" width="200" height="60" as="geometry" /></mxCell>
<mxCell id="p2_k3" value="判定为 KEY3 (DOWN)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="467" width="160" height="45" as="geometry" /></mxCell>
<mxCell id="p2_knone" value="判定为 BTN_NONE (无按键)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="467" width="180" height="45" as="geometry" /></mxCell>
<mxCell id="p2_chk_cand" value="识别结果 == s_btn_candidate ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="560" width="240" height="60" as="geometry" /></mxCell>
<mxCell id="p2_inc_cand" value="稳定计数器累加&#xa;s_btn_candidate_count++" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="650" width="200" height="45" as="geometry" /></mxCell>
<mxCell id="p2_rst_cand" value="s_btn_candidate = now&#xa;s_btn_candidate_count = 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="650" width="220" height="45" as="geometry" /></mxCell>
<mxCell id="p2_chk_stable" value="计数 &gt;= 3 (稳定 60ms)&#xa;且与前一确认状态不同?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="730" width="260" height="70" as="geometry" /></mxCell>
<mxCell id="p2_chk_edge" value="是否为新按下边沿?&#xa;(prev == NONE 且 now != NONE)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="840" width="260" height="70" as="geometry" /></mxCell>
<mxCell id="p2_emit" value="触发有效按键事件!&#xa;返回 BTN_UP / BTN_OK / BTN_DOWN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="950" width="260" height="50" as="geometry" /></mxCell>
<mxCell id="p2_ret_none" value="返回 BTN_NONE (无新事件)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="852" width="200" height="45" as="geometry" /></mxCell>
<mxCell id="e2_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_start" target="p2_read"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_read" target="p2_hyst"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_hyst" target="p2_keep"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_hyst" target="p2_w1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_w1" target="p2_k1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_w1" target="p2_w2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_w2" target="p2_k2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_8" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_w2" target="p2_w3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_9" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_w3" target="p2_k3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_10" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_w3" target="p2_knone"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_k1" target="p2_chk_cand"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_k2" target="p2_chk_cand"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_k3" target="p2_chk_cand"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_knone" target="p2_chk_cand"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_keep" target="p2_chk_cand"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_16" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_chk_cand" target="p2_inc_cand"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_17" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_chk_cand" target="p2_rst_cand"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_inc_cand" target="p2_chk_stable"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_rst_cand" target="p2_chk_stable"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_20" value="是 (更新状态)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_chk_stable" target="p2_chk_edge"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_21" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_chk_stable" target="p2_ret_none"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_22" value="是 (刚按下)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_chk_edge" target="p2_emit"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e2_23" value="否 (松开或长按)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p2_chk_edge" target="p2_ret_none"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_3" name="3.UI状态机与焦点导航">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="750" math="0" shadow="0">
      <root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="p3_g1" value="主界面 (SCR_HOME)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#495057;startSize=30;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="460" height="600" as="geometry" /></mxCell>
<mxCell id="p3_f0" value="焦点 0: 正在阅读卡片&#xa;[人间草木 45%]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="100" width="260" height="50" as="geometry" /></mxCell>
<mxCell id="p3_f1" value="焦点 1: 今日待办卡片&#xa;[待办清单列表]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="190" width="260" height="50" as="geometry" /></mxCell>
<mxCell id="p3_f2" value="焦点 2..9: 8个应用宫格&#xa;[书架/笔记/日历/文件/市场/浏览器/设置/时钟]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="280" width="260" height="60" as="geometry" /></mxCell>
<mxCell id="p3_f3" value="焦点 10..13: 4个底部Tab&#xa;[首页/发现/灵感/我的]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="380" width="260" height="50" as="geometry" /></mxCell>
<mxCell id="p3_upd" value="焦点切换动作:&#xa;1. 计算新旧区域并集 rect_union&#xa;2. memcpy(fb, g_static_fb)&#xa;3. 绘制新焦点外白内黑高亮框&#xa;4. partial_refresh 局部刷新 (MODE_GL16)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="470" width="380" height="90" as="geometry" /></mxCell>
<mxCell id="p3_g2" value="阅读器界面 (SCR_READING)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#495057;startSize=30;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="40" width="460" height="600" as="geometry" /></mxCell>
<mxCell id="p3_r_init" value="进入阅读器:&#xa;1. s_read_page = 0&#xa;2. draw_reading() 清白屏并画文字&#xa;3. full_refresh() 全屏刷新" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="380" height="70" as="geometry" /></mxCell>
<mxCell id="p3_r_view" value="阅读文章内容&#xa;页眉: 人间草木 · 汪曾祺 (当前页/总页数)&#xa;内容: 每页 16 行诗文&#xa;底栏: UP/DOWN 翻页  OK 返回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="220" width="380" height="100" as="geometry" /></mxCell>
<mxCell id="p3_r_up" value="UP 键: s_read_page-- (上一页)&#xa;draw_reading() + partial_refresh()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="360" width="380" height="50" as="geometry" /></mxCell>
<mxCell id="p3_r_down" value="DOWN 键: s_read_page++ (下一页)&#xa;draw_reading() + partial_refresh()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="430" width="380" height="50" as="geometry" /></mxCell>
<mxCell id="p3_r_back" value="OK 键: 返回主页&#xa;s_screen = SCR_HOME, prepare_home(), full_refresh()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="510" width="380" height="50" as="geometry" /></mxCell>
<mxCell id="e3_1" value="DOWN / UP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p3_f0" target="p3_f1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3_2" value="DOWN / UP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p3_f1" target="p3_f2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3_3" value="DOWN / UP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p3_f2" target="p3_f3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3_4" value="循环" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p3_f3" target="p3_f0"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3_ok1" value="在 [正在阅读] 卡片上按 OK 键" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p3_f0" target="p3_r_init"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3_r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p3_r_init" target="p3_r_view"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3_r2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p3_r_view" target="p3_r_up"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3_r3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p3_r_view" target="p3_r_down"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3_r4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p3_r_view" target="p3_r_back"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3_back" value="返回主页" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p3_r_back" target="p3_f0"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_4" name="4.双缓冲局部刷新机制">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="600" math="0" shadow="0">
      <root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="p4_title" value="双缓冲与局部快速刷新机制 (Dual Buffer &amp; Partial Refresh Optimization)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="200" y="30" width="700" height="45" as="geometry" /></mxCell>
<mxCell id="p4_b1" value="1. 开机预渲染 (Boot)&#xa;- PSRAM 分配 776KB 静态缓存 (g_static_fb)&#xa;- 复制高分辨率水墨背景 img_bg_data&#xa;- 绘制状态栏、Hero 日期、卡片与应用图标&#xa;* 整个复杂渲染只执行 1 次！" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="320" height="110" as="geometry" /></mxCell>
<mxCell id="p4_b2" value="2. 按键事件触发 (Event)&#xa;- 用户按下 UP 或 DOWN 键&#xa;- 计算焦点从 old_focus 变更为 new_focus&#xa;- 计算两个区域的最小外接矩形 rect_union&#xa;  r = rect_union(focus_rect(old), focus_rect(new))" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="360" height="110" as="geometry" /></mxCell>
<mxCell id="p4_b3" value="3. 内存极速还原与高亮框重绘&#xa;- memcpy(fb, g_static_fb, SW * SH / 2)&#xa;  毫秒级还原没有亮框的干净底图！&#xa;- 在 fb 上绘制新焦点的双层边框 (外白内黑)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="260" width="320" height="100" as="geometry" /></mxCell>
<mxCell id="p4_b4" value="4. 局部墨水屏刷新 (partial_refresh)&#xa;- gpio_set_level(EPD_PWR_PIN, 1) 开启高压供电&#xa;- 清空 dirty_lines 并将目标区域映射为行波形&#xa;- epd_hl_update_area(&amp;hl, MODE_GL16, temp, band)&#xa;- gpio_set_level(EPD_PWR_PIN, 0) 关闭供电节能" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="260" width="360" height="100" as="geometry" /></mxCell>
<mxCell id="p4_b5" value="为什么这种设计极快且不伤墨水屏？&#xa;• 零背景重绘开销：无需在 CPU 端重绘繁杂背景，仅做一次 memcpy&#xa;• 无黑白闪烁：采用 MODE_GL16 灰度平滑刷新，仅变动行驱动&#xa;• 超低功耗：刷新完毕立即拉低 GPIO 46 断开电荷泵高压供电" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="400" width="700" height="90" as="geometry" /></mxCell>
<mxCell id="e4_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p4_b1" target="p4_b2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e4_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p4_b2" target="p4_b3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e4_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p4_b3" target="p4_b4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e4_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;" edge="1" parent="1" source="p4_b4" target="p4_b5"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>